# Backend Environment Variables
# Copy this to .env and fill in the values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Database
DATABASE_URL=sqlite:///backend/paisapreneur.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/paisapreneur

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=900  # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRES=604800  # 7 days in seconds

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,https://paisapreneur.com

# Render/Production
PORT=8000
