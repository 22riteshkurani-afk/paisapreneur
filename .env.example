# ═══════════════════════════════════════════════════════════════════════════
# Paisapreneur AI Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# ═══════════════════════════════════════════════════════════════════════════

# Google Gemini API Key (get yours at: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (e.g. gemini-1.5-flash or gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Application Security & CORS
SECRET_KEY=paisapreneur_secret_key_change_me_in_prod
ALLOWED_ORIGINS=*

# Performance & Rate Limits
CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Cashfree Payment Gateway (Optional / Sandbox)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX
